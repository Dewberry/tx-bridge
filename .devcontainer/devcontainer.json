{
  "name": "PDAL Dev Container",
  "build": {
    "dockerfile": "../Dockerfile",
    "args": {
      "DEV": "true"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "mounts": ["source=${localWorkspaceFolder},target=/TX-BRIDGE,type=bind"],
  "remoteUser": "root"
}
